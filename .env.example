# Server Port (default 4000)
PORT=4000

# Admin Authentication:
# Hashed password generated via scrypt (salt:derived_key).
# Generate using: node scripts/hash-password.js <your-password>
ADMIN_PASSWORD_HASH=replace_with_hash_output_from_hash-password_js

# Session cookie secret for signing admin auth tokens
# Generate a random one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_random_32_byte_hex

# Data directory for SQLite database
DB_PATH=./data/noticeboard.db

# Max file upload size in MB (default 15MB)
MAX_UPLOAD_MB=15

# Web Push (VAPID) keys - generate with: npx web-push generate-vapid-keys
# Fill these in before enabling push notifications
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_EMAIL=mailto:admin@example.com
